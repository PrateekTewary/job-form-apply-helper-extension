{
  "manifest_version": 3,
  "name": "Job Form Autofill",
  "version": "1.0.0",
  "description": "Autofills job application forms using saved user profile data.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://job-boards.greenhouse.io/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Job Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://job-boards.greenhouse.io/*"
      ],
      "js": [
        "popup/popup.js",
        "config/fieldMappings.js",
        "core/inputUtils.js",
        "adapters/databricks.js",
        "adapters/genericAdapter.js",
        "adapters/adapterRegistry.js",
        "core/storage.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}